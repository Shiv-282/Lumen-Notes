<?xml version="1.0" encoding="utf-8"?>
<vector xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:aapt="http://schemas.android.com/aapt"
    android:width="108dp"
    android:height="108dp"
    android:viewportWidth="108"
    android:viewportHeight="108">

    <!-- Translucent glass page -->
    <group
        android:rotation="-6"
        android:pivotX="54"
        android:pivotY="57">
        <path
            android:pathData="M34,33 h32 a7,7 0 0 1 7,7 v34 a7,7 0 0 1 -7,7 h-32 a7,7 0 0 1 -7,-7 v-34 a7,7 0 0 1 7,-7 Z"
            android:fillColor="#2EFFFFFF"
            android:strokeColor="#99FFFFFF"
            android:strokeWidth="1.6" />
        <!-- Text lines on the page -->
        <path
            android:pathData="M37,46 h20"
            android:strokeColor="#66FFFFFF"
            android:strokeWidth="2.4"
            android:strokeLineCap="round" />
        <path
            android:pathData="M37,54 h14"
            android:strokeColor="#4DFFFFFF"
            android:strokeWidth="2.4"
            android:strokeLineCap="round" />
    </group>

    <!-- Luminous ink stroke sweeping across -->
    <path
        android:pathData="M32,74 C44,66 54,54 74,32"
        android:strokeWidth="5.5"
        android:strokeLineCap="round"
        android:fillColor="#00000000">
        <aapt:attr name="android:strokeColor">
            <gradient
                android:startX="32"
                android:startY="74"
                android:endX="74"
                android:endY="32"
                android:type="linear">
                <item android:offset="0" android:color="#FF7DD3FC" />
                <item android:offset="0.5" android:color="#FFA78BFA" />
                <item android:offset="1" android:color="#FFF0ABFC" />
            </gradient>
        </aapt:attr>
    </path>

    <!-- Lumen spark at the pen tip -->
    <path
        android:pathData="M73,31 m-5.2,0 a5.2,5.2 0 1 1 10.4,0 a5.2,5.2 0 1 1 -10.4,0"
        android:fillColor="#2EFFFFFF" />
    <path
        android:pathData="M73,31 m-2.6,0 a2.6,2.6 0 1 1 5.2,0 a2.6,2.6 0 1 1 -5.2,0"
        android:fillColor="#FFFFFFFF" />
</vector>
